# nix build output links
result
result-*

# Syncthing, if this repo is shared between the machines that way
.stfolder/
.stversions/
*.sync-conflict-*

# Pre-commit config: nix develop links it from the store
.pre-commit-config.yaml

# Secrets: only the encrypted files and the public key list are tracked
/secrets/*
!/secrets/*.age
!/secrets/secrets.nix
*.key
.env
.env.*
