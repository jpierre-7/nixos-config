{
  "$schema": "https://www.schemastore.org/claude-code-keybindings.json",
  "$docs": "https://code.claude.com/docs/en/keybindings",
  "bindings": [
    {
      "context": "Scroll",
      "bindings": {
        "ctrl+end": null,
        "alt+k": "scroll:lineUp",
        "alt+j": "scroll:lineDown",
        "alt+u": "scroll:fullPageUp",
        "alt+d": "scroll:fullPageDown",
        "alt+g": "scroll:top",
        "alt+shift+g": "scroll:bottom"
      }
    }
  ]
}
